# Copy to .env.prod and run: chmod 600 .env.prod
# Used by docker-compose.prod.yml; never commit the copy.

CLERK_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# From: stripe listen --print-secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Generate each one with: openssl rand -hex 24
# Only letters and digits: these go inside connection strings and URLs.
# PostgreSQL and RabbitMQ read theirs only when their data volume is first created.
POSTGRES_PASSWORD=
BOOKING_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
RABBITMQ_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
